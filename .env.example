# Server mode override. Remove APP_MODE to permit browser provider selection.
# Rules mode is transparent and needs no provider credentials.
APP_MODE=rules
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Groq is the optional hosted model provider. Use APP_MODE=groq to select it.
# Verify this model's availability and billing in your Groq account first.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Server-only OpenAI-compatible local model configuration.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=

# Optional 0G Compute Router provider. Keep the sk- key server-side.
OG_COMPUTE_API_KEY=
OG_COMPUTE_BASE_URL=https://router-api.0g.ai/v1
OG_COMPUTE_MODEL=
OG_COMPUTE_TRUST_MODE=private

# Free-tool safety configuration.
PUBLIC_SOURCE_ALLOWLIST=asdma.assam.gov.in,ndma.gov.in,imd.gov.in,who.int
IMPACTRELAY_USER_AGENT=ImpactRelay/0.4 local development

# Local persistence override. The default is data/impactrelay.sqlite.
IMPACTRELAY_DB_PATH=

# Hosted infrastructure. Leave DATABASE_URL empty for local SQLite mode.
DATABASE_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_MODE=disabled
REDIS_CACHE_PREFIX=impactrelay
